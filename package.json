{
  "name": "twitch-chat-viewer",
  "version": "1.0.12",
  "description": "Twitch Chat Viewer - Windows Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "node_modules\\electron\\dist\\electron.exe .",
    "install-deps": "npm install",
    "dist": "electron-builder --win",
    "dist:publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.twitch.chatviewer",
    "productName": "TwitchChatViewer",
    "publish": [
      {
        "provider": "github",
        "owner": "donkma93",
        "repo": "chatbot",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  }
}
